# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID de la aplicación (Developer Portal > General Information > Application ID)
CLIENT_ID=
# (Opcional) ID de un servidor de pruebas: los comandos aparecen al instante.
# Déjalo vacío para registrar comandos globales (pueden tardar un rato en aparecer).
GUILD_ID=
# Registrar comandos automáticamente al iniciar (true/false)
AUTO_DEPLOY=true
